{
  "name": "synclair",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "license": "GPL-3.0-or-later",
  "homepage": "https://synclair.dev",
  "scripts": {
    "dev": "next dev -p 4100",
    "build": "next build",
    "start": "next start -p 4100",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "check:registry": "node scripts/check-registry.mjs",
    "check:previews": "node scripts/check-previews.mjs",
    "check:host": "node scripts/check-host-drift.mjs",
    "check:coverage": "node scripts/check-host-coverage.mjs",
    "scan:hygiene": "node scripts/scan-host-hygiene.mjs",
    "check:ux-docs": "node scripts/check-ux-docs.mjs",
    "check:purity": "node scripts/check-foundation-purity.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "resolve:pages": "node scripts/resolve-page-items.mjs",
    "host:status": "node scripts/host-servers.mjs status",
    "host:up": "node scripts/host-servers.mjs up",
    "call-home": "node scripts/call-home.mjs",
    "bridge:agents": "node scripts/bridge-agents.mjs",
    "check:agent-bridge": "node scripts/bridge-agents.mjs --check",
    "check:cellfade-foundation": "node scripts/check-cellfade-foundation.mjs",
    "check:control-plane-docs": "node scripts/check-control-plane-docs.mjs",
    "check:vercel-capabilities": "node scripts/probe-vercel-capabilities.mjs --check-only",
    "preflight:vercel": "node scripts/probe-vercel-capabilities.mjs --check-only --require-cli --require-resolved --report docs/control-plane/vercel-capabilities.json",
    "check:secrets": "node scripts/check-secrets.mjs --require-gitleaks",
    "check:foundation-release": "node scripts/check-foundation-release.mjs",
    "bootstrap:foundation": "node tools/install-actionlint.mjs && node tools/install-gitleaks.mjs --install && node scripts/build-foundation-manifest.mjs",
    "build:foundation-manifest": "node scripts/build-foundation-manifest.mjs",
    "check:foundation-manifest": "node scripts/build-foundation-manifest.mjs --check",
    "check:workflows": "node scripts/check-workflows.mjs --require-actionlint",
    "test:phase0": "node --test test/phase0-tooling.test.mjs",
    "test:pilot-readiness": "node --test test/pilot-readiness.test.mjs",
    "test:project-manifest": "node --test test/project-manifest-validation.test.mjs",
    "test:embedded-lifecycle": "node --test test/embedded-bootstrap-lifecycle.test.mjs",
    "test:governance-scaffold": "node --test test/governance-scaffold.test.mjs",
    "test:foundation-security": "node --test test/foundation-manifest-security.test.mjs",
    "test:cli-deprecation": "node scripts/test-cli-deprecation.mjs",
    "verify-ui": "npm run check:cellfade-foundation && npm run check:secrets && npm run typecheck && npm run lint && npm run check:registry && npm run check:previews && npm run check:ux-docs && npm run check:purity && npm run check:pages && npm run check:agent-bridge",
    "verify:foundation": "npm run test:phase0 && npm run test:pilot-readiness && npm run test:project-manifest && npm run test:embedded-lifecycle && npm run test:governance-scaffold && npm run test:foundation-security && npm run check:control-plane-docs && npm run check:vercel-capabilities && npm run check:foundation-release && npm run check:foundation-manifest && npm run test:cli-deprecation && npm run check:workflows && npm run verify-ui",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.23.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "ajv": "8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "patch-package": "^8.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "shadcn": "4.13.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.21",
      "sharp": "0.35.3"
    }
  }
}
